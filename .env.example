# 只放「数据库连上之前」就必须知道的启动值。模型、召回 / 判定 / 学习参数、令牌等
# 一律在管理后台配置(模型 → 服务商与模型 / 模型绑定;设置 → 运行参数 / 访问与安全),保存即生效。

# PostgreSQL(必填;docker compose 全栈模式下由 compose 注入主机名)
CE_PG_HOST=localhost
CE_PG_PORT=5432
CE_PG_DB=cognitive_enzyme
CE_PG_USER=enzyme
CE_PG_PASSWORD=enzyme

# 首次启动时创建的管理员(库里还没有任何用户时才生效);密码留空则生成随机密码并打在服务端日志里,登录后请立即修改
CE_ADMIN_USER=
CE_ADMIN_PASSWORD=

# JWT 签名密钥;留空则首次启动自动生成并保存在数据库里
CE_JWT_SECRET=

# 头像等上传文件的本地目录
CE_DATA_DIR=data

# Qdrant 首次启动的默认地址;之后在「设置 → 运行参数 → 系统」修改(需重启)
CE_QDRANT_URL=http://localhost:6333
